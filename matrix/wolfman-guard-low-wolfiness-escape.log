        "more": false,
        "visible": [
          {
            "runs": [
              {
                "kind": "Plain",
                "text": "Как назло, на дороге не появлялось ещё ни одной машины, а вам так хотелось поскорее попасть домой. К тому же, вам снова захотелось есть. Заметив за деревьями бар для дальнобойщиков, вы решили туда зайти.",
                "target": ""
              }
            ],
            "joinPrevious": false
          }
        ]
      },
      "variables": {
        "wolfiness": 0,
        "hp": 3,
        "barExit": false,
        "forestExit": false,
        "wolvesTalk": false,
        "guardDone": false
      },
      "model": {
        "layout": "VisualNovel",
        "pageId": "c28ae684-785a-4442-8756-8f5a7e9fb0c1",
        "caption": "",
