        "more": true,
        "visible": [
          {
            "runs": [
              {
                "kind": "Plain",
                "text": "Внезапно раздалось рычание, и перед вами возник волк с оскаленной мордой. Это был огромный зверь, крупнее вас.",
                "target": ""
