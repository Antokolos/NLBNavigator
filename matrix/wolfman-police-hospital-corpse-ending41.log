      "schema": 1,
      "index": 5,
      "command": "shot:D:\\deepseek-harness\\default-workspace\\.tmp\\matrix73\\wolfman-police-hospital-corpse-ending41\\nlbnavigator\\wolfman-police-hospital-corpse-to-page13-choices.01-opening.png",
      "ok": true,
      "pageId": "f12432d9-dd8f-40fc-97bd-f9a15cc21ff6",
      "screen": "page",
      "finished": false,
      "portion": {
        "index": 0,
        "count": 10,
        "more": true,
        "visible": [
          {
            "runs": [
              {
                "kind": "Plain",
                "text": "Вы очнулись лежащим посреди тротуара. Полная луна уже показалась из-за крыш и ярко светила вам в лицо. Вокруг не было ни души.",
                "target": ""
              }
            ],
            "joinPrevious": false
          }
        ]
      },
      "variables": {
        "wolfiness": 0,
        "hp": 3,
        "barExit": false,
        "forestExit": false,
