        "more": false,
        "visible": [
          {
            "runs": [
              {
                "kind": "Plain",
                "text": "Там вы действительно примеряли волчью шкуру… Решив отдохнуть в ближайшей роще, а вечером отправиться в дом злодея, заколдовавшего вас, вы спрятались в густом кустарнике, где и заснули под мерное гудение пчёл.",
                "target": ""
              }
            ],
            "joinPrevious": false
          }
        ]
