    {
      "seq": 50,
      "kind": "scene",
      "command": "click true,1,960,540",
      "arguments": "",
      "rendered": "<a:act 01>Попытаться прорваться сквозь полицию</a>\n\n <a:act 02>Перепрыгнуть через забор</a>\n\n \n",
      "page_id": "f12432d9-dd8f-40fc-97bd-f9a15cc21ff6",
      "location_id": "v_f12432d9_dd8f_40fc_97bd_f9a15cc21ff6",
