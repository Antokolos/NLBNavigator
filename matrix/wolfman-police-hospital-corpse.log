      "state_trace": {
        "seq": 102,
        "kind": "scene",
        "command": "click true,1,960,540",
        "arguments": "",
        "rendered": "Вы очнулись от яркого света, который проникал даже сквозь опущенные веки. Вы лежали на чём-то твёрдом и холодном.\n",
        "page_id": "8c1fa8c6-8027-43c8-8d8b-0bf454d5e717",
        "location_id": "v_8c1fa8c6_8027_43c8_8d8b_0bf454d5e717",
        "room_id": "v_8c1fa8c6_8027_43c8_8d8b_0bf454d5e717",
