    {
      "schema": 1,
      "index": 22,
      "command": "shot:D:\\deepseek-harness\\default-workspace\\.tmp\\matrix2\\wolfman-opening\\nlbnavigator\\04-jump-over-fence.png",
      "ok": true,
      "pageId": "5b5d038f-ce4d-4cc8-8bee-81de8528b1a5",
      "screen": "page",
      "finished": false,
      "portion": {
        "index": 0,
        "count": 5,
        "more": true,
        "visible": [
          {
            "runs": [
              {
                "kind": "Plain",
                "text": "Бежать прямо на вооружённых полицейских -- не лучшая идея. Обернувшись, вы с тоской оглядели забор позади себя. Подпрыгнуть так высоко человеку не под силу.",
                "target": ""
              }
            ],
            "joinPrevious": false
          }
        ]
      },
      "variables": {
        "wolfiness": 0,
        "hp": 3,
        "barExit": false,
        "forestExit": false,
        "wolvesTalk": false,
        "guardDone": false
      },
      "model": {
        "layout": "VisualNovel",
        "pageId": "5b5d038f-ce4d-4cc8-8bee-81de8528b1a5",
        "caption": "",
        "roomTitle": "",
        "pageImage": {
