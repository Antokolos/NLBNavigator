        "guardDone": false
      },
      "model": {
        "layout": "VisualNovel",
        "pageId": "d937c5c1-766c-4581-a03e-736560b0cc8f",
        "caption": "",
        "roomTitle": "",
        "pageImage": {
          "file": "4.png",
          "framePattern": "",
