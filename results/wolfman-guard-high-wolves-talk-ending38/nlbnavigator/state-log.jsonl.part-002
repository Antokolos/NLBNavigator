{"schema":1,"index":152,"command":"shot:/workspace/nlb-pr72.brkxnMDx/results/wolfman-guard-high-wolves-talk-ending38/nlbnavigator/wolfman-guard-high-talk-to-page27.guard-high-wolves-talk-page26.png","ok":true,"pageId":"0e3e04d8-03e7-459d-8136-e7c135100101","screen":"page","finished":false,"portion":{"index":0,"count":8,"more":true,"visible":[{"runs":[{"kind":"Plain","text":"Внезапно раздалось рычание, и перед вами возник волк с оскаленной мордой. Это был огромный зверь, крупнее вас.","target":""}],"joinPrevious":false}]},"variables":{"wolfiness":2,"hp":3,"barExit":true,"forestExit":true,"wolvesTalk":true,"guardDone":false},"model":{"layout":"VisualNovel","pageId":"0e3e04d8-03e7-459d-8136-e7c135100101","caption":"","roomTitle":"","pageImage":{"file":"26.png","framePattern":"","frameCount":0,"currentFrame":0,"looped":false},"imageIsBackground":false,"forceDsc":false,"pageText":[{"runs":[{"kind":"Plain","text":"Внезапно раздалось рычание, и перед вами возник волк с оскаленной мордой. Это был огромный зверь, крупнее вас. Вы приготовились к драке, но монстр не спешил нападать. Шумно втянув носом воздух, он заговорил с вами:","target":""}],"joinPrevious":false},{"runs":[{"kind":"Plain","text":"-- Кто ты? Откуда здесь взялся?","target":""}],"joinPrevious":false},{"runs":[{"kind":"Plain","text":"-- Хозяин этого дома сделал меня оборотнем. Я пришёл, чтобы разделаться с ним, -- честно ответили вы.","target":""}],"joinPrevious":false},{"runs":[{"kind":"Plain","text":"-- Ты тоже надевал волчью шкуру? -- уже мягче спросил зверь.","target":""}],"joinPrevious":false},{"runs":[{"kind":"Plain","text":"-- Да.","target":""}],"joinPrevious":false},{"runs":[{"kind":"Plain","text":"-- Меня он превратил тем же способом. Теперь я у него что-то вроде сторожевого пса, -- с тоской сообщил оборотень. -- Человеком мне уже не стать. А у тебя ещё есть шанс?","target":""}],"joinPrevious":false},{"runs":[{"kind":"Plain","text":"-- Не знаю. Но очень надеюсь.","target":""}],"joinPrevious":false}],"re