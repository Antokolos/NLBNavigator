        {
          "seq": 161,
          "kind": "scene",
          "command": "click true,1,960,540",
          "arguments": "",
          "rendered": "— Этот вроде не похож на моих... А что это у него на шее такое? Телефон?\n",
          "page_id": "30f2da3a-76a3-40b2-84f0-41714eb48ae4",
          "location_id": "v_30f2da3a_76a3_40b2_84f0_41714eb48ae4",
          "room_id": "v_30f2da3a_76a3_40b2_84f0_41714eb48ae4",
          "screen_kind": "page",
          "page_name": "Am I a Monster?",
