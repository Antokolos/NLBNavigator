    {
      "schema": 1,
      "index": 51,
      "command": "shot:/workspace/nlb-pr72.brkxnMDx/results/wolfman-forest-wolfiness-one-rowan-ending34/nlbnavigator/wolfman-forest-wolfiness-one-to-page20.11-wolfiness-zero-outcome.png",
