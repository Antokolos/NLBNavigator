      "command": "shot:/workspace/nlb-pr72.brkxnMDx/results/wolfman-forest-wolfiness-one-rowan-ending34/nlbnavigator/wolfman-forest-wolfiness-one-to-page20.12-zoo-escape-final-portion.png",
