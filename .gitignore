# Ignore all files by default, but scan all directories.
*
!*/

# Do not ignore git files in the root of the repo.
!/.git*

# Do not ignore current project's `.uproject`.
!/*.uproject

# Do not ignore current project's image.
!/*.png

# Do not ignore current project's icon.
!/Build/Windows/Application.ico
!/Build/Mac/Application.icns
!/Build/Linux/Application.png

# Do not ignore source, config and plugins dirs.
!/Source/**
!/Config/**
!/Plugins/**

# Only allow .uasset and .umap files from /Content dir.
# They're tracked by git-lfs, don't forget to track other
# files if adding them here.
!/Content/**/*.uasset
!/Content/**/*.umap

# Allow any files from current project's Splash.
!/Content/Splash/**/*

# Allow any files from current project's Platforms folder.
!/Platforms/**/*

# Allow any files from /RawContent dir.
# Any file in /RawContent dir will be managed by git lfs.
!/RawContent/**/*

!CMakeLists.txt

# OS/platform generated files.

# Windows
ehthumbs.db
Thumbs.db

# Mac OS X
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# vim
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist

# Visual Studio
.vs
# Документация и адаптеры движков (Godot, Unreal)
!/docs/**
!/integrations/**
!/android/**
!/tools/**
!/nlb.json
!/CLAUDE.md
# ... кроме собранных модулей и каталогов сборки
/integrations/godot/demo/bin/
/integrations/godot/demo/.godot/
/integrations/**/build/

# Расширения платформ консолей (Platforms/<платформа>) — в закрытом репозитории (docs/consoles.md):
# код под SDK закрыт NDA и в этот, открытый, репозиторий не попадает
/Platforms/

# Differential route validator and its unit tests.
!/tests/differential/route_validation.py
!/tests/differential/test_route_validation.py
!/tests/differential/test_select_routes.py
!/tests/differential/test_advance_until.py
!/tests/differential/test_choose_prefix.py
# Примеры маршрутов на новых действиях раннера (не маршруты CI: те — в routes/)
!/tests/differential/examples/
!/tests/differential/examples/*.json
!/tests/differential/examples/fragments/
!/tests/differential/examples/fragments/*.json
!/tests/differential/ci/
!/tests/differential/ci/*.py
!/tests/differential/ci/*.sh

# Python: байт-код
__pycache__/
*.pyc
