    {
      "schema": 1,
      "index": 102,
      "command": "shot:/workspace/nlb-pr72.brkxnMDx/results/wolfman-guard-high-wolves-attack/nlbnavigator/19-wolfiness-positive-final-portion.png",
      "ok": true,
      "pageId": "b2f0838e-3068-4850-ad2f-4944075de38b",
